<Window x:Class="EcossistemaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EcossistemaApp"
        mc:Ignorable="d"
        Title="1V99 - Nosso Ecossistema"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== MAIN CONTENT ===== -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        Width="1100"
                        Margin="0,20,0,60">

                <!-- Logo area -->
                <Border HorizontalAlignment="Center" Margin="0,20,0,50">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Crown / 1V99 logo text -->
                        <TextBlock Text="♛"
                                   FontSize="36"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="1V99"
                                   FontSize="22"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Subtitle -->
                <TextBlock Text="ESCOLHA SEU CAMINHO"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,8">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Main title -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,60">
                    <TextBlock Text="NOSSO "
                               FontSize="44"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="ECOSSISTEMA"
                               FontSize="44"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource AccentBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColor}"
                                              BlurRadius="18"
                                              ShadowDepth="0"
                                              Opacity="0.45" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- ===== CARDS GRID ===== -->
                <UniformGrid Columns="4" Margin="0,0,0,0">

                    <!-- Card 01 - FIVEM -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="01" Style="{StaticResource StepText}" />

                            <!-- Icon -->
                            <Border Style="{StaticResource IconBorder}"
                                    Background="#25FFD400">
                                <TextBlock Text="🎮"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="FIVEM SERVER" Style="{StaticResource LabelText}" />
                            <TextBlock Text="FIVEM" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource DescText}"
                                       Text="A maior comunidade de dominação do FiveM Brasil. Conquiste territórios, forme alianças e prove que você é o único." />
                        </StackPanel>
                    </Border>

                    <!-- Card 02 - CREATORS -->
                    <Border Margin="5,0,5,0"
                            BorderThickness="1"
                            Padding="22"
                            MinHeight="280">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#8CFFD400" />
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#0AFFD400" Offset="0" />
                                <GradientStop Color="#40000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="02" Style="{StaticResource StepText}" />

                            <!-- Icon -->
                            <Border Style="{StaticResource IconBorder}"
                                    Background="#25FFD400">
                                <TextBlock Text="👥"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="MEDIA PORTAL" Style="{StaticResource LabelText}" />
                            <TextBlock Text="CREATORS" Style="{StaticResource CardTitle}"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Style="{StaticResource DescText}"
                                       Text="Crie seu perfil, compartilhe suas conquistas e conecte-se com a comunidade. Seja reconhecido." />
                        </StackPanel>
                    </Border>

                    <!-- Card 03 - STORE -->
                    <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0" Opacity="0.5">
                        <StackPanel>
                            <TextBlock Text="03" Style="{StaticResource StepText}" />

                            <!-- Icon -->
                            <Border Style="{StaticResource IconBorder}"
                                    Background="#25FFD400">
                                <TextBlock Text="🛒"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="OFFICIAL MERCH" Style="{StaticResource LabelText}" />

                            <!-- Title with BREVE badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="STORE"
                                           FontSize="24"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" />
                                <Border Background="Transparent"
                                        BorderBrush="{StaticResource MutedBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="6,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="BREVE"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Style="{StaticResource DescText}"
                                       Text="Roupas e acessórios exclusivos da marca 1V99. Mousepads, camisetas e manguitos." />
                        </StackPanel>
                    </Border>

                    <!-- Card 04 - CONFIGS -->
                    <Border Style="{StaticResource CardBorder}" Margin="9,0,0,0">
                        <StackPanel>
                            <TextBlock Text="04" Style="{StaticResource StepText}" />

                            <!-- Icon -->
                            <Border Style="{StaticResource IconBorder}"
                                    Background="#25FFD400">
                                <TextBlock Text="⚙"
                                           FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="CONFIG PORTAL" Style="{StaticResource LabelText}" />
                            <TextBlock Text="CONFIGS" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource DescText}"
                                       Text="Compartilhe suas configurações de mira, sensibilidade e settings do GTA." />
                        </StackPanel>
                    </Border>

                </UniformGrid>
            </StackPanel>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2"
                    Padding="40,20"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#15FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- BE THE ONE. -->
                    <StackPanel Orientation="Horizontal"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="40,0,0,0">
                        <TextBlock Text="BE THE "
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="ONE"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="."
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                    </StackPanel>

                    <!-- Social icons -->
                    <StackPanel Orientation="Horizontal"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource SocialButton}" Content="💬" ToolTip="Discord" />
                        <Button Style="{StaticResource SocialButton}" Content="📷" ToolTip="Instagram" />
                        <Button Style="{StaticResource SocialButton}" Content="✕" ToolTip="X (Twitter)" />
                        <Button Style="{StaticResource SocialButton}" Content="♪" ToolTip="TikTok" />
                    </StackPanel>

                    <!-- Copyright -->
                    <TextBlock Grid.Column="2"
                               Text="© 2026 1V99"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,40,0" />
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Window>
